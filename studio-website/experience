<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EASIS | EXPERIENCE</title>
    <style>
        :root { --white: #F9F9F9; --black: #111111; --accent-blue: #00E1D9; }
        body { background-color: var(--white); color: var(--black); margin: 0; font-family: "Space Grotesque", sans-serif; }

        .main-wrapper { display: grid; grid-template-columns: 300px 1fr; gap: 80px; max-width: 1200px; margin: 100px auto; padding: 0 40px; }
        
        /* 标题固定 */
        .left-side { position: sticky; top: 100px; height: fit-content; }
        .page-title { font-size: 5rem; text-transform: uppercase; margin: 0; }
        .page-title::after { content: ''; display: block; width: 80px; height: 12px; background: var(--accent-blue); margin-top: 15px; }

        /* 内容板块 */
        .section-box { margin-bottom: 80px; }
        .section-label { font-size: 0.9rem; font-weight: 900; text-transform: uppercase; opacity: 0.5; margin-bottom: 30px; display: block; }
        
        /* 简历卡片样式 */
        .item-card { border-left: 3px solid var(--black); padding-left: 30px; margin-bottom: 40px; }
        .item-title { font-size: 1.5rem; font-weight: 900; margin-bottom: 5px; }
        .item-meta { font-weight: 700; opacity: 0.7; margin-bottom: 10px; }
        
        /* 技能云 */
        .skills-grid { display: flex; flex-wrap: wrap; gap: 15px; }
        .skill-tag { border: 1.5px solid var(--black); padding: 8px 20px; font-weight: 700; }
    </style>
</head>
<body>

    <!-- 导航栏保持一致 (略) -->

    <main class="main-wrapper">
        <div class="left-side">
            <h1 class="page-title">CV</h1>
        </div>

        <div class="right-side">
            <!-- Work -->
            <section class="section-box">
                <span class="section-label">Work Experience</span>
                <div class="item-card">
                    <div class="item-title">Lead Researcher | Company A</div>
                    <div class="item-meta">2023 - Present</div>
                    <p>Focused on innovation strategy and economic modeling for urban growth.</p>
                </div>
            </section>

            <!-- Education -->
            <section class="section-box">
                <span class="section-label">Education</span>
                <div class="item-card">
                    <div class="item-title">MSc Economics | University Name</div>
                    <div class="item-meta">2021 - 2023</div>
                </div>
            </section>

            <!-- Wins -->
            <section class="section-box">
                <span class="section-label">Wins & Honors</span>
                <div class="item-card">
                    <div class="item-title">Innovation Award 2024</div>
                    <p>Recognized for excellence in sustainable design research.</p>
                </div>
            </section>

            <!-- Skills -->
            <section class="section-box">
                <span class="section-label">Core Skills</span>
                <div class="skills-grid">
                    <span class="skill-tag">Economic Modeling</span>
                    <span class="skill-tag">Data Visualization</span>
                    <span class="skill-tag">Strategic Planning</span>
                    <span class="skill-tag">Creative Writing</span>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
